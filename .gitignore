# ============================================================================
# Poolaris .gitignore
# ============================================================================

# --- Runtime data: NEVER commit (real pool data, DB, backups, logs, PII) ----
# The server recreates data/ on first run; a fresh clone starts empty.
data/

# --- Secrets (none are committed; this is defensive) -----------------------
.env
.env.*
*.key
*.pem

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv/
venv/
env/

# --- Internal planning / audit / security-critique docs (kept local) -------
# Remove this line if you want to publish the design docs.
docs/

# --- Dev & test artifacts --------------------------------------------------
# Everything prefixed with __ is local scratch (audit harnesses, detail logs,
# screenshots, the throwaway Edge profile, the test-server launcher) — never committed.
__*
*.tmp

# --- Logs ------------------------------------------------------------------
*.log

# --- Node (only used by the test harness; no deps are vendored) ------------
node_modules/

# --- OS / editor cruft -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
